{
  "name": "squirrelingo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/generate-version-json.js && next dev",
    "build": "node scripts/generate-version-json.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "node scripts/deploy.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gen-tree": "node scripts/gen-repo-tree.mjs",
    "voices:list": "node scripts/voices-list.mjs",
    "changelog:rollup": "node scripts/rollup-changelog.mjs",
    "changelog:check": "node scripts/rollup-changelog.mjs --check",
    "verify:l10n": "node scripts/verify-l10n-explain.mjs && node scripts/verify-l10n-lazy.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "globals": "^17.9.0"
  }
}
